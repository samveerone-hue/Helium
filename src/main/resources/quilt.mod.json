{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.helium",
    "id": "helium",
    "version": "${version}",
    "metadata": {
      "name": "Helium",
      "description": "Client-side performance and rendering optimizations for Minecraft, with optional visual features.",
      "contributors": {},
      "contact": {},
      "license": "MIT",
      "icon": "assets/helium/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client": [
        "com.helium.HeliumClient"
      ],
      "modmenu": [
        "com.helium.compat.HeliumModMenuIntegration"
      ],
      "sodium:config_api_user": [
        "com.helium.compat.HeliumSodiumConfig"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.19.0"
      },
      {
        "id": "minecraft",
        "versions": ">=1.21.11 <=1.21.11"
      },
      {
        "id": "java",
        "versions": ">=25"
      },
      {
        "id": "cloth-config",
        "versions": ">=15.0.0"
      }
    ],
    "suggests": [
      {
        "id": "sodium",
        "versions": ">=0.8.14 <0.9.0"
      }
    ]
  },
  "mixin": [
    "helium.mixins.json"
  ]
}
