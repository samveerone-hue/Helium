{
  "schemaVersion": 1,
  "id": "helium",
  "version": "${version}",
  "name": "Helium",
  "description": "Client-side performance and rendering optimizations for Minecraft, with optional visual features.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/helium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.helium.HeliumClient"
    ],
    "modmenu": [
      "com.helium.compat.HeliumModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "com.helium.compat.HeliumSodiumBooleanConfig"
    ]
  },
  "mixins": [
    "helium.mixins.json"
  ],
  "accessWidener": "helium.accesswidener",
  "depends": {
    "minecraft": "1.21.11",
    "java": ">=25",
    "cloth-config": ">=15.0.0"
  },
  "suggests": {
    "sodium": ">=0.8.14 <0.9.0",
    "lithium": "*",
    "iris": "*",
    "immediatelyfast": "*",
    "modmenu": "*"
  }
}
